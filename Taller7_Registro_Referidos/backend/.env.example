# Copia este archivo como .env y ajusta los valores si es necesario.
# Estos datos deben coincidir con los del docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=multicatalogo
DB_PASSWORD=multicatalogo
DB_NAME=multicatalogo

# Alternativa: si defines DATABASE_URL se usa en lugar de las variables anteriores.
# DATABASE_URL=postgres://multicatalogo:multicatalogo@localhost:5432/multicatalogo?sslmode=disable

# Redis guarda temporalmente las consultas más repetidas.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cambia este valor por una cadena privada de al menos 32 caracteres.
JWT_SECRET=cambia-esta-clave-por-una-muy-larga-y-privada

# Alternativa: si defines REDIS_URL se usa en lugar de las variables anteriores.
# REDIS_URL=redis://localhost:6379/0

# Orígenes permitidos para CORS (frontend de Vite).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
