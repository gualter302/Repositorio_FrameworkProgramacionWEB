{$DOMAIN:localhost} {
    encode gzip
    handle /api/* {
        reverse_proxy backend:3000
    }
    handle {
        root * /srv
        @sw path /sw.js /manifest.webmanifest /workbox-*
        header @sw Cache-Control "no-cache"
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        try_files {path} /index.html
        file_server
    }
}
