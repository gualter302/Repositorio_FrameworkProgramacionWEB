# Copia este archivo como .env y ajusta los valores si es necesario.
# Estos datos deben coincidir con los del docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=multicatalogo
DB_PASSWORD=multicatalogo
DB_NAME=multicatalogo

# Alternativa: si defines DATABASE_URL se usa en lugar de las variables anteriores.
# DATABASE_URL=postgres://multicatalogo:multicatalogo@localhost:5432/multicatalogo?sslmode=disable

# Orígenes permitidos para CORS (frontend de Vite).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
